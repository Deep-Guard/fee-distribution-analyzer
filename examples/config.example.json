      "tokenSymbol": "USDC",
      "tokenCoingeckoId": "usd-coin",
      "tokenDecimals": 6
    },
    {
      "label": "Swap fees to Stakers",
      "recipient": "Stakers",
      "contractAddress": "0xYOUR_FEE_CONTRACT_ADDRESS",
      "eventSignature": "FeeToStakers(address indexed token, uint256 amount)",
      "amountArgName": "amount",
      "tokenAddress": "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48",
      "tokenSymbol": "USDC",
      "tokenCoingeckoId": "usd-coin",
      "tokenDecimals": 6
    },
    {
      "label": "Token burn",
      "recipient": "Burn",
      "contractAddress": "0xYOUR_TOKEN_ADDRESS",
      "eventSignature": "Transfer(address indexed from, address indexed to, uint256 value)",
      "amountArgName": "value",
      "tokenAddress": "0xYOUR_TOKEN_ADDRESS",
